+    let scale = font
+        .pt_to_px_scale(font_size)
+        .unwrap_or(ab_glyph::PxScale::from(font_size));
+    let advance = font.as_scaled(scale).h_advance(font.glyph_id(c));
+    let cells = unicode_width::UnicodeWidthChar::width(c)
